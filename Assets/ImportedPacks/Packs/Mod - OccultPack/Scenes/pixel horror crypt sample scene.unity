  m_EditorClassIdentifier: 
  dialog:
    EventName: brother michael
    EventStrings:
    - "\u201CHello. Thanks for coming, Brother. Daniel is in the other room researching
      the plague. I\u2019m very sorry about the smell. We thought the Holy Sword
      was unappeased and was therefore causing the Blight. It wasn\u2019t. But really\u2026
      who are we to waste a good sacrifice? That guy was a total piece of\u2014\u201D\n\u201C\u2026Never
      mind. Thanks again for coming.\u201D"
    ItemObj: {fileID: 0}
    itemKind: 4
  NPCName: michael
